PORT=3000
DATA_DIR=./data
SESSION_SECRET=change-me-long-random-string
ADMIN_PASSWORD=change-me
PUBLIC_URL=http://localhost:3000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:me@filipkin.com
OSRM_URL=https://router.project-osrm.org
# Proxies in front that append X-Forwarded-For (1 behind Coolify). 0 uses the socket address.
TRUST_PROXY_HOPS=0
# Optional: serve the web build from another directory
# WEB_DIST=./web/dist

# Sign-in by phone and Google (SPEC 18). Either of the next two turns it on. With neither, /login
# shows only the staff password and a crew QR (/j/<token>) signs in directly.
# Service-account JSON of the Firebase project, on one line (Coolify secret):
FIREBASE_SERVICE_ACCOUNT=
# Local Auth emulator from docker-compose.yml (no SMS is ever sent):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-lrbuddy
# Web build, read by vite at build time. Firebase web config as JSON, or the emulator URL alone:
# VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"lrbuddy.firebaseapp.com","projectId":"lrbuddy","appId":"..."}
# VITE_FIREBASE_EMULATOR=http://127.0.0.1:9099
